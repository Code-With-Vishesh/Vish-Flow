# Placeholders only. The two PUBLIC values below go into GitHub: Settings > Secrets and variables > Actions > Variables.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# PRIVATE values: GitHub > Settings > Secrets and variables > Actions > Secrets. Never commit them or paste them in chat.
# SUPABASE_ACCESS_TOKEN=   (supabase.com/dashboard/account/tokens)
# SUPABASE_DB_PASSWORD=    (the database password you chose when creating the project)
# SUPABASE_PROJECT_ID=     (the "project ref": the xxxx in https://xxxx.supabase.co)
